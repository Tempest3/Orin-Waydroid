+ * <tr>
+ *   <td><tt>/dev/nvgpu/dgpu-xxxx:bb:dd.f/</tt></td>
+ *   <td>dGPU</td>
+ *   <td>Here xxxx=domain, bb=bus, dd=device, f=function.</td>
+ * </tr>
+ * <tr>
