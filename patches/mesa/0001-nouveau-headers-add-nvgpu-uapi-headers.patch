diff --git a/include/drm-uapi/nvgpu-event.h b/include/drm-uapi/nvgpu-event.h
new file mode 100644
index 00000000000..47dc7212ae2
--- /dev/null
+++ b/include/drm-uapi/nvgpu-event.h
@@ -0,0 +1,76 @@
+/*
