 NVKMD_DECL_SUBCLASS(va, nvgpu);
 
+struct nvkmd_nvgpu_exec_ctx {
+   struct nvkmd_ctx base;
+
+   int channel_fd;
+   int tsg_fd;
+   uint32_t veid;
+   uint64_t copy_object_id;
+   uint64_t threeD_object_id;
+   uint64_t twoD_object_id;
+   uint64_t m2mf_object_id;
+   uint64_t compute_object_id;
+   // struct nvkmd_mem *notifier;
+   // struct nvkmd_mem *userD;
+   struct nvkmd_mem *gp_fifo;
+   struct nvkmd_mem *zcull_buf;
+
+   int push_count;
+   bool is_fence_filled;
+   struct nvgpu_fence fence;
+   // struct nvkmd_mem *cmdBuf;
+   // NvHandle hCtxDma;
+   // NvHandle hChannel;
+   // struct {
+	//    NvHandle hCopy;
+	//    NvHandle hEng2d;
+	//    NvHandle hEng3d;
+	//    NvHandle hM2mf;
+	//    NvHandle hCompute;
+   // } subchannels;
+   // int osEvent;
+   // struct NvRmSemSurf *semSurf;
+   // uint64_t wSeq;
+   // uint64_t gpGet;
+   // uint64_t gpPut;
+};
+
+NVKMD_DECL_SUBCLASS(ctx, nvgpu_exec);
+
 VkResult nvkmd_nvgpu_alloc_va(struct nvkmd_dev *dev,
                                 struct vk_object_base *log_obj,
                                 enum nvkmd_va_flags flags, uint8_t pte_kind,
@@ -87,3 +169,47 @@ VkResult nvkmd_nvgpu_create_ctx(struct nvkmd_dev *dev,
                                   struct vk_object_base *log_obj,
                                   enum nvkmd_engines engines,
                                   struct nvkmd_ctx **ctx_out);
+
+struct nvkmd_nvgpu_sync {
+   struct vk_sync base;
+
+   bool initialized;
+   uint32_t syncpoint_id;
+
+   int64_t local_offset; // offset from drm value to logical value
+};
+
+void
+nvkmd_nvgpu_sync_finish(struct vk_device *device,
+                       struct vk_sync *sync);
+
+static inline bool
+vk_sync_type_is_nvkmd_nvgpu_sync(const struct vk_sync_type *type)
+{
+   return type->finish == nvkmd_nvgpu_sync_finish;
+}
+
+static inline struct nvkmd_nvgpu_sync *
+vk_sync_as_nvgpu_sync(struct vk_sync *sync)
+{
+   if (!vk_sync_type_is_nvkmd_nvgpu_sync(sync->type))
+      return NULL;
+
+   return container_of(sync, struct nvkmd_nvgpu_sync, base);
+}
+
+struct vk_sync_type
+nvkmd_nvgpu_sync_get_type(struct nvkmd_nvgpu_pdev *pdev);
+
+
+static inline int nvgpu_ioctl(int fd, int num, void* ptr) {
+   while(true) {
+      if (ioctl(fd, num, ptr) == -1) {
+         if (errno == EAGAIN) {
+            continue;
+         }
+         return -1;
+      }
+      return 0;
+   }
+}
