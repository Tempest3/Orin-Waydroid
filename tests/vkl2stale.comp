#version 460
// dst[i] = src[i] via buffer device addresses (scripts/vkl2stale.c)
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 256) in;
layout(buffer_reference, std430) buffer U32s { uint v[]; };
layout(push_constant) uniform PC { U32s src; U32s dst; uint n; };
void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i < n)
      dst.v[i] = src.v[i];
}
